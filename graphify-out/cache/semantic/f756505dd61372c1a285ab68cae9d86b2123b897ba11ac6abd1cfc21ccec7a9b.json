{"nodes": [{"id": "components_n10_floating_on_scroll_morph_floating_on_scroll_morph_navigation", "label": "Floating-on-Scroll Morph Navigation", "file_type": "rationale", "source_file": ".agents/skills/hallmark/references/components/n10-floating-on-scroll-morph.md", "source_location": "heading N10", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One sticky navigation DOM should morph from a bar into a floating pill with a single class toggle and timing curve."}, {"id": "components_n10_floating_on_scroll_morph_floating_navigation_four_laws", "label": "Floating Navigation Four Laws", "file_type": "concept", "source_file": ".agents/skills/hallmark/references/components/n10-floating-on-scroll-morph.md", "source_location": "paragraph beginning The full recipe", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Keep height constant, offset with transforms, cross-fade all changing properties, and use one timing curve."}, {"id": "components_n10_floating_on_scroll_morph_single_dom_crossfade", "label": "Single-DOM Navigation Crossfade", "file_type": "concept", "source_file": ".agents/skills/hallmark/references/components/n10-floating-on-scroll-morph.md", "source_location": "anti-pattern paragraph", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Swapping two header elements harms focus order and content synchronization; cross-fade one DOM instead."}], "edges": [{"source": "components_n10_floating_on_scroll_morph_floating_on_scroll_morph_navigation", "target": "components_n10_floating_on_scroll_morph_floating_navigation_four_laws", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/hallmark/references/components/n10-floating-on-scroll-morph.md", "source_location": "paragraph beginning The full recipe", "weight": 1.0}, {"source": "components_n10_floating_on_scroll_morph_floating_on_scroll_morph_navigation", "target": "components_n10_floating_on_scroll_morph_single_dom_crossfade", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/hallmark/references/components/n10-floating-on-scroll-morph.md", "source_location": "description and anti-pattern", "weight": 1.0}], "hyperedges": []}